---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';

import Footer from '@/components/Footer.astro';
import FooterScripts from '@/components/FooterScripts.astro';
import FooterScriptsGallery from '@/components/FooterScriptsGallery.astro';
import BaseHead from '@/components/NewsHead.astro';
import Podpiska from '@/components/Podpiska.astro';
import { SELECTORS } from '@/constants/dom';
import { IMAGE_SIZES } from '@/constants/image';
import { CONFIG_CLIENT } from '@/config/client';
import { wrapUrl } from '@/utils/urls';

import Avatar from '@/assets/images/logotelegrafbel.svg';

const SiteUrl = wrapUrl(CONFIG_CLIENT.SITE_URL);

const { hasGallery = false } = Astro.props;
const data = Astro.props;

const { SCROLL_TO_TOP_ID } = SELECTORS;

// Список ссылок для меню
const menuLinks = [
  { href: wrapUrl('https://telegraf.news/hashtag/belarus/'), label: 'Беларусь' },
  { href: wrapUrl('/world-news/'), label: 'Мир' },
  { href: wrapUrl('https://telegraf.news/obshhestvo/'), label: 'Общество' },
  { href: wrapUrl('https://telegraf.news/politika/'), label: 'Политика' },
  { href: wrapUrl('https://telegraf.news/ehkonomika/'), label: 'Экономика' },
  { href: wrapUrl('https://telegraf.news/zdorove/'), label: 'Здоровье' },
  { href: wrapUrl('https://telegraf.news/lifehacks/'), label: 'Лайфхаки' },
  { href: wrapUrl('https://telegraf.news/auto/'), label: 'Авто' },
  { href: wrapUrl('https://telegraf.news/proisshestviya/'), label: 'Происшествия' },
];
---

<html lang="ru-BY">
  <BaseHead {data} />
  <body class="flex flex-col min-h-screen text-tel-black font-sans text-[16px] bg-white">
    <!-- Header -->
    <header id={SCROLL_TO_TOP_ID} class="bg-tel-black sticky top-0 z-50">
      <div class="container h-10 flex items-center justify-between">
        <a href={SiteUrl}>
          <Image
            {...IMAGE_SIZES.FIXED.AVATAR}
            loading="eager"
            class="shrink-0 select-none"
            src={Avatar}
            alt="Telegraf.news"
          />
        </a>

        <!-- Десктоп меню -->
        <nav class="hidden md:flex space-x-4 text-white text-[15px] font-medium">
          {menuLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>

        <!-- Кнопки -->
        <div class="head_buttons flex items-center">
          <button id="mobileMenuButton" class="md:hidden" aria-expanded="false">
            <Icon name="mdi:hamburger-menu" class="text-white text-3xl mr-1 menu-icon-open" />
            <Icon name="mdi:close" class="text-white text-3xl mr-1 hidden menu-icon-close" />
          </button>
          <button id="searchButton">
            <Icon name="mdi:magnify" class="text-white text-2xl" />
          </button>
        </div>

        <!-- Мобильное меню -->
        <nav
          id="mobileMenu"
          class="fixed inset-y-0 left-0 w-64 bg-tel-black shadow-lg transform -translate-x-full transition-transform duration-300 ease-in-out z-50"
        >
          <button
            id="closeMenu"
            class="close-menu absolute top-2 right-3 text-gray-400 hover:text-white"
          >
            <Icon name="mdi:close" class="text-2xl" />
          </button>
          <ul class="flex flex-col p-4 space-y-4">
            {
              menuLinks.map((link) => (
                <li>
                  <a href={link.href} class="block py-2 hover:opacity-75 text-white">
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <Podpiska theme="black" title="Соцсети:" />
        </nav>

        <!-- Поиск и оверлей (без изменений) -->
        <div id="searchPanel" class="fixed w-full justify-center left-0 p-2 z-50 hidden">
          <div
            class="relative top-[4.5rem] pt-5 max-w-lg w-full bg-tel-black shadow-lg mx-auto overflow-hidden transform transition-all duration-300 ease-in-out scale-95 opacity-0"
          >
            <form role="search" method="get" action="https://telegraf.news//poisk/" class="p-4">
              <div class="flex gap-2">
                <input
                  type="search"
                  class="flex-1 px-2 py-3 bg-gray-800 text-white placeholder-gray-400 focus:outline-none focus:ring-2"
                  placeholder="Поиск по сайту"
                  name="q"
                  title="Поиск по сайту:"
                />
                <button
                  type="submit"
                  class="px-2 py-1 bg-white text-tel-black font-medium transition-colors duration-200"
                >
                  Найти
                </button>
              </div>
            </form>
            <button
              id="closeSearch"
              class="close-search absolute top-1 right-3 text-gray-400 hover:text-white"
            >
              <Icon name="mdi:close" class="text-2xl" />
            </button>
          </div>
        </div>

        <div id="Overlay" class="fixed inset-0 bg-black bg-opacity-70 z-40 hidden"></div>
      </div>
    </header>

    <slot />
    <Footer />
    <FooterScripts />
    {hasGallery && <FooterScriptsGallery />}
  </body>
</html>
