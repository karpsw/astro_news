---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';

import BaseHead from '@/components/NewsHead.astro';
import { SELECTORS } from '@/constants/dom';
import { IMAGE_SIZES } from '@/constants/image';

import Avatar from '@/assets/images/logotelegrafbel.svg';

const { data } = Astro.props;

const { SCROLL_TO_TOP_ID } = SELECTORS;
---

<html lang="ru-BY">
  <BaseHead {data} />
  <body class="bg-white text-tel-black font-sans text-[16px]">
    <!--   Header -->
    <header id={SCROLL_TO_TOP_ID} class="bg-tel-black sticky top-0 z-50">
      <div class="container h-10 flex items-center justify-between">
        <a href="/" class="">
          <Image
            {...IMAGE_SIZES.FIXED.AVATAR}
            loading="eager"
            class="shrink-0 select-none"
            src={Avatar}
            alt="Telegraf.news"
          />
        </a>
        <nav class="hidden md:flex space-x-4 text-white text-[15px] font-medium">
          <a href="#">Беларусь</a>
          <a href="#">Мир</a>
          <a href="#">Общество</a>
          <a href="#">Политика</a>
          <a href="#">Экономика</a>
          <a href="#">Здоровье</a>
          <a href="#">Лайфхаки</a>
          <a href="#">Авто</a>
          <a href="#">Происшествия</a>
        </nav>

        <!-- Кнопка меню -->
        <div class="head_buttons flex items-center">
          <button id="mobileMenuButton" class="md:hidden" aria-expanded="false">
            <Icon name="mdi:hamburger-menu" class="text-white text-3xl mr-1 menu-icon-open" />
            <Icon name="mdi:close" class="text-white text-3xl mr-1 hidden menu-icon-close" />
          </button>
          <!-- Другие кнопки -->
          <button id="searchButton">
            <Icon name="mdi:magnify" class="text-white text-2xl" />
          </button>
        </div>

        <!-- Мобильное меню -->
        <nav
          id="mobileMenu"
          class="fixed inset-y-0 left-0 w-64 bg-tel-black shadow-lg transform -translate-x-full transition-transform duration-300 ease-in-out z-50"
        >
          <ul class="flex flex-col p-4 space-y-4">
            <li><a href="#" class="block py-2 hover:opacity-75 text-white">Беларусь</a></li>
            <li><a href="#" class="block py-2 hover:opacity-75 text-white">Мир</a></li>
            <li><a href="#" class="block py-2 hover:opacity-75 text-white">Общество</a></li>
            <li><a href="#" class="block py-2 hover:opacity-75 text-white">Политика</a></li>
            <li><a href="#" class="block py-2 hover:opacity-75 text-white">Экономика</a></li>
            <li><a href="#" class="block py-2 hover:opacity-75 text-white">Здоровье</a></li>
            <li><a href="#" class="block py-2 hover:opacity-75 text-white">Лайфхаки</a></li>
            <li><a href="#" class="block py-2 hover:opacity-75 text-white">Авто</a></li>
            <li><a href="#" class="block py-2 hover:opacity-75 text-white">Происшествия</a></li>
          </ul>
        </nav>

        <!-- Поисковая панель (центрированная) -->
        <div
          id="searchPanel"
          class="fixed inset-0 flex items-center justify-center p-4 z-50 hidden"
        >
          <div
            class="relative pt-5 max-w-lg w-full bg-tel-black shadow-lg overflow-hidden transform transition-all duration-300 ease-in-out scale-95 opacity-0"
          >
            <form role="search" method="get" action="https://telegraf.news//poisk/" class="p-4">
              <div class="flex gap-2">
                <input
                  type="search"
                  class="flex-1 px-2 py-3 bg-gray-800 text-white placeholder-gray-400 focus:outline-none focus:ring-2"
                  placeholder="Поиск по сайту"
                  name="q"
                  title="Поиск по сайту:"
                />
                <button
                  type="submit"
                  class="px-2 py-1 bg-white text-tel-black font-medium transition-colors duration-200"
                >
                  Найти
                </button>
              </div>
            </form>
            <button id="closeSearch" class="absolute top-1 right-3 text-gray-400 hover:text-white">
              <Icon name="mdi:close" class="text-2xl" />
            </button>
          </div>
        </div>

        <!-- Затемнение фона -->
        <div id="Overlay" class="fixed inset-0 bg-black bg-opacity-70 z-40 hidden"></div>
      </div>
    </header>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const menuButton = document.getElementById('mobileMenuButton');
        const mobileMenu = document.getElementById('mobileMenu');
        const menuOverlay = document.getElementById('Overlay');
        const openIcon = document.querySelector('.menu-icon-open');
        const closeIcon = document.querySelector('.menu-icon-close');

        menuButton.addEventListener('click', () => {
          const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';

          // Переключаем состояние
          menuButton.setAttribute('aria-expanded', !isExpanded);

          // Анимация меню
          mobileMenu.classList.toggle('-translate-x-full');

          // Переключаем иконки
          openIcon.classList.toggle('hidden');
          closeIcon.classList.toggle('hidden');

          // Затемнение фона
          menuOverlay.classList.toggle('hidden');

          // Блокировка скролла
          document.body.classList.toggle('overflow-hidden');
        });

        // Закрытие по клику на оверлей
        menuOverlay.addEventListener('click', () => {
          mobileMenu.classList.add('-translate-x-full');
          menuOverlay.classList.add('hidden');
          openIcon.classList.remove('hidden');
          closeIcon.classList.add('hidden');
          menuButton.setAttribute('aria-expanded', 'false');
          document.body.classList.remove('overflow-hidden');
        });
      });

      document.addEventListener('DOMContentLoaded', () => {
        const searchButton = document.getElementById('searchButton');
        const searchPanel = document.getElementById('searchPanel');
        const searchOverlay = document.getElementById('Overlay');
        const closeButton = document.getElementById('closeSearch');
        const searchInput = document.querySelector('input[type="search"]');
        const searchForm = document.querySelector('#searchPanel > div');

        function openSearch() {
          searchOverlay.classList.remove('hidden');
          searchPanel.classList.remove('hidden');

          // Анимация появления
          setTimeout(() => {
            searchForm.classList.remove('scale-95', 'opacity-0');
            searchForm.classList.add('scale-100', 'opacity-100');
          }, 10);

          document.body.classList.add('overflow-hidden');
          searchInput.focus();
        }

        function closeSearch() {
          searchForm.classList.remove('scale-100');
          searchForm.classList.add('scale-95', 'opacity-0');

          setTimeout(() => {
            searchPanel.classList.add('hidden');
            searchOverlay.classList.add('hidden');
            document.body.classList.remove('overflow-hidden');
          }, 300);
        }

        searchButton.addEventListener('click', openSearch);
        searchOverlay.addEventListener('click', closeSearch);
        closeButton.addEventListener('click', closeSearch);

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeSearch();
        });
      });
    </script>

    <slot />

    <!--   Footer -->
    <footer class="bg-tel-black py-6 mt-8">
      <div
        class="container text-sm text-white flex flex-col md:flex-row justify-between items-center space-y-2 md:space-y-0"
      >
        <span>&copy; 2025 Telegraf.news</span>
        <div class="flex space-x-4">
          <a href="#" class="">О нас</a>
          <a href="#" class="">Контакты</a>
          <a href="#" class="">Политика конфиденциальности</a>
        </div>
      </div>
    </footer>
  </body>
</html>
