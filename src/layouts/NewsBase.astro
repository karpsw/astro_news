---
import BaseHead from '@/components/BaseHead.astro';

import type { BaseProps } from './Base.astro';

const { metadata } = Astro.props as BaseProps;
---

<html lang="en">
  <BaseHead {metadata} />
  <body class="bg-[#f8f9fa] text-gray-800 font-sans text-[16px]">
    <!--   Header -->
    <header class="bg-white border-b border-gray-200 sticky top-0 z-50">
      <div
        class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between"
      >
        <a href="/" class="text-[18px] font-bold text-gray-900">Telegraf</a>
        <nav class="hidden md:flex space-x-4 text-gray-700 text-[15px] font-medium">
          <a href="#">Беларусь</a>
          <a href="#">Мир</a>
          <a href="#">Общество</a>
          <a href="#">Политика</a>
          <a href="#">Экономика</a>
          <a href="#">Здоровье</a>
          <a href="#">Лайфхаки</a>
          <a href="#">Авто</a>
          <a href="#">Происшествия</a>
        </nav>
        <button class="text-gray-500 hover:text-blue-600">
          <div class="w-8 h-8 rounded-full bg-gray-300 flex items-center justify-center">
            <svg
              class="w-4 h-4 text-white"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              ><path d="M21 21l-4.35-4.35M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14z"></path></svg
            >
          </div>
        </button>
      </div>
    </header>

    <slot />

    <!--   Footer -->
    <footer class="bg-white border-t border-gray-200 py-6 mt-8">
      <div
        class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8 text-sm text-gray-500 flex flex-col md:flex-row justify-between items-center space-y-2 md:space-y-0"
      >
        <span>&copy; 2025 Telegraf.news</span>
        <div class="flex space-x-4">
          <a href="#" class="hover:text-blue-600">О нас</a>
          <a href="#" class="hover:text-blue-600">Контакты</a>
          <a href="#" class="hover:text-blue-600">Политика конфиденциальности</a>
        </div>
      </div>
    </footer>
  </body>
</html>
