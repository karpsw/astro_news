---
import '@/assets/styles/news-markdown.css';

import ArticleAfterText1 from 'Reklama/ArticleAfterText1.astro';
import ArticleInText1 from 'Reklama/ArticleInText1.astro';
import ArticleIntext2 from 'Reklama/ArticleIntext2.astro';
import Sidebar3 from 'Reklama/Sidebar3.astro';
import sanitizeHtml from 'sanitize-html';

import LabelPost from '@/components/Labelpost.astro';
import LazyIsland from '@/components/LazyIsland.astro';
import Podpiska from '@/components/Podpiska.astro';
// блоки новостей
import PostBlockShareaholic from '@/components/PostBlocks/PostBlockShareaholic.astro';
import Share from '@/components/Share.astro';
import Telepicture from '@/components/Telepicture.astro';
import { telDate } from '@/utils/datetime';
import { renderMarkdown } from '@/utils/markdown';
import { wrapUrl } from '@/utils/urls';
import NewsBase from './NewsBase.astro';

// для новости
const { data, content } = Astro.props;
const { tags = [] } = data;

//показывать рекламу или нет
const vyklReklama = data.vyklreklama;

//const html = await renderMarkdown(rawMd);

//текст новости
const { code: contentHtml } = await renderMarkdown(content);
const safeTitle = sanitizeHtml(data.title || 'Изображение', {
  allowedTags: [],
  allowedAttributes: {},
});
const finalcontentHtml = contentHtml.replaceAll('default-alt-content', safeTitle);

//лид
const { code: lidtHtml } = await renderMarkdown(data.lid ?? '');
const finalid = lidtHtml.replaceAll('p-1', 'p-0');

// галерея внутри текста
const hasGallery = contentHtml.indexOf('splide') > 0;
// автор

const authorName = data.avtor_name?.trim() ? data.avtor_name : 'Редакция';

const authorUrl = wrapUrl('https://telegraf.news/redakciya/');
---

<NewsBase {...data} hasGallery={hasGallery} vyklReklama={vyklReklama}>
  <!-- container -->
  <div class="container grid grid-cols-1 lg:grid-cols-[2fr_1fr] gap-8">
    <div class="left">
      <!-- 📄 Article Section -->
      <article role="main" class="">
        <header class="">
          <h1
            class="md:text-4xl text-3xl font-bold text-tel-black border-b border-gray-200 mt-6 mb-4 pb-5"
          >
            {data.title}
          </h1>
          <div class="flex flex-wrap justify-between items-center text-xs">
            <div class="w-full grid grid-cols-1 md:grid-cols-[auto_1fr] gap-2">
              <!-- Левый блок: дата, автор, label -->
              <div
                class="w-full grid grid-cols-[repeat(auto-fit,minmax(0,1fr))] md:flex md:flex-nowrap"
              >
                {
                  data.date && (
                    <time
                      itemprop="datePublished"
                      datetime={telDate(data.date)}
                      class="bg-cyan-700 p-1 text-center text-white p-2"
                    >
                      {telDate(data.date)}
                    </time>
                  )
                }

                <a
                  href={authorUrl}
                  class="bg-slate-500 px-3 p-2 text-center text-white hover:bg-slate-600 transition-colors overflow-hidden truncate"
                >
                  {authorName}
                </a>

                {data.label && <LabelPost label={data.label} />}
              </div>

              <!-- Правый блок: категория + теги -->
              {
                (data.category || (tags && tags.length > 0)) && (
                  <div class="flex flex-wrap items-center gap-1 w-full">
                    {data.category && (
                      <a
                        rel="tag"
                        href={wrapUrl(data.category_slug)}
                        class="bg-slate-100 hover:bg-slate-200 p-1"
                        title={`#${data.category}`}
                      >
                        #{data.category}
                      </a>
                    )}

                    {tags &&
                      tags.length > 0 &&
                      tags.map(
                        (tag) =>
                          tag?.name &&
                          tag?.slug && (
                            <a
                              rel="tag"
                              href={wrapUrl(tag.slug)}
                              class="bg-slate-100 p-1 hover:bg-slate-200"
                              title={`#${tag.name}`}
                              key={tag.slug}
                            >
                              #{tag.name}
                            </a>
                          )
                      )}
                  </div>
                )
              }
            </div>
            <!-- Image Placeholder -->
            <div class="w-full bg-gray-200 rounded-md flex items-center justify-center mt-4">
              <!-- Картинка -->
              <Telepicture
                src={data.featured_img_url}
                loading="eager"
                imgclass="aspect-[16/9] max-w-full block"
                posttitle={data.title}
                lightbox="yes"
                srcSets={{
                  desctop: { w: 891, h: 501 },
                  medium: { w: 903, h: 495 },
                  modile: { w: 437, h: 252 },
                }}
              />
            </div>

            <!--  Subscribe Block -->
            <Podpiska />
          </div>
        </header>
        <section id="post-text" class="prose max-w-none prose-tel-red my-5">
          <Fragment set:html={finalid} />
          {!vyklReklama && <ArticleInText1 />}
          <Fragment set:html={finalcontentHtml} />
        </section>
        <footer>
          {!vyklReklama && <ArticleAfterText1 />}
          <Share />
        </footer>
      </article>

      <!-- блок рекомендаций -->
      <PostBlockShareaholic title="Подобрали для вас" className="mt-5" location={data.permalink} />
      <!-- Блоки: главные, популярные -->
      <LazyIsland url="/fragments/PostBlocksLazy/" />
    </div>
    <!-- конец Left -->
    <!-- Sidebar -->
    <aside class="mt-[-0.8rem] md:mt-8">
      <LazyIsland url="/fragments/PostSidebar/" wrap="div">
        <div id="currency-widget" class="bg-white border border-gray-200 p-4 rounded-md mb-5">
          <h2 class="text-lg font-semibold text-gray-700 mb-4">Курсы валют</h2>
          <div id="currency-content">
            <div class="animate-pulse">
              <div class="h-4 bg-gray-200 rounded mb-2"></div>
              <div class="h-4 bg-gray-200 rounded mb-2"></div>
              <div class="h-4 bg-gray-200 rounded mb-2"></div>
              <div class="h-4 bg-gray-200 rounded mb-2"></div>
              <div class="h-4 bg-gray-200 rounded"></div>
            </div>
          </div>
        </div>
      </LazyIsland>
      <!--  пикачу  -->
      {!vyklReklama && <Sidebar3 />}
    </aside>
  </div>
  <!-- /container -->
</NewsBase>
