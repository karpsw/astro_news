---
//import Markdown from 'astro-remote/lib/Markdown.astro';

import { getMarkdown } from '@/modules/post/getArchive';
import FullWidth from '@/layouts/FullWidth.astro';
import NewsMeta from '@/components/NewsMeta.astro';
import { renderMarkdown } from '@/utils/markdown';

import type { BaseHeadProps } from '@/components/BaseHead.astro';

const { slug } = Astro.params;

const { data, content } = await getMarkdown(slug!);
const metadata = { metadata: { title: data.title } } as BaseHeadProps;
//const html = await renderMarkdown(rawMd);
const { code: contentHtml } = await renderMarkdown(content);
const { code: lidtHtml } = await renderMarkdown(data.lid ?? '');
const postMetaProps = {
  publishDate: data.date,
  category: data.category,
  category_slug: data.category_slug,
  tags: data.tags,
};
---

<FullWidth {...metadata}>
  <section class="centered-px max-w-3xl b-h2-my">
    <h1 class="b-h1">{data.title}</h1>
  </section>
  <figure class="centered max-w-4xl">
    {
      data.featured_img_url && (
        <img
          src={data.featured_img_url}
          alt={data.featured_img_caption}
          loading="eager"
          class="block max-w-full h-auto aspect-[16/8] object-cover border border-base-300"
        />
      )
    }
  </figure>

  <section class="centered-px max-w-3xl b-h2-my">
    <NewsMeta {...postMetaProps} />
    <article class="m-2 p-2 bg-slate-200" set:html={lidtHtml} />
  </section>

  <section class="my-prose centered-px max-w-3xl b-h2-my">
    <article class="" set:html={contentHtml} />
  </section>
</FullWidth>
