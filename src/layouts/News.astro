---
//import Markdown from 'astro-remote/lib/Markdown.astro';

import { Icon } from 'astro-icon/components';

import { getMarkdown } from '@/modules/post/getArchive';
import LabelPost from '@/components/Labelpost.astro';
import Telepicture from '@/components/Telepicture.astro';
import { telDate } from '@/utils/datetime';
import { renderMarkdown } from '@/utils/markdown';
import NewsBase from './NewsBase.astro';

const { slug } = Astro.params;

const { data, content } = await getMarkdown(slug!);
const { tags } = data;
//const html = await renderMarkdown(rawMd);
const { code: contentHtml } = await renderMarkdown(content);
const { code: lidtHtml } = await renderMarkdown(data.lid ?? '');

// автор

const authorName = data.avtor_name?.trim() ? data.avtor_name : 'Редакция';

const authorUrl = 'https://telegraf.news/redakciya/';
---

<NewsBase {data}>
  <!-- 📰 Main Content-->
  <main class="container grid grid-cols-1 lg:grid-cols-[2fr_1fr] gap-8">
    <!-- 📄 Article Section -->
    <article class="">
      <header class="">
        <h1
          class="md:text-4xl text-3xl font-bold text-tel-black border-b border-gray-200 mt-6 mb-4 pb-5"
        >
          {data.title}
        </h1>
        <div class="flex flex-wrap justify-between items-center text-xs">
          <div
            class="group mb-2 md:mb-0 items-center w-full md:w-auto grid grid-cols-3 auto-cols-max"
          >
            {
              data.date && (
                <time
                  itemprop="datePublished"
                  datetime={telDate(data.date)}
                  class="bg-cyan-700 mr-0 p-1 items-center text-white "
                >
                  {telDate(data.date)}
                </time>
              )
            }
            <!-- добавить имя автора в апи -->
            <a
              href={authorUrl}
              class="bg-slate-500 px-3 py-1 text-white hover:bg-slate-600 transition-colors overflow-x-hidden truncate"
            >
              {authorName}
            </a>
            <LabelPost label={data.label} />
          </div>
          <div class="text-xs text-gray-900 font-medium flex flex-wrap items-center">
            <div class="bg-tel-red p-1 items-center text-white mr-1">Темы:</div>
            <a rel="tag" class="bg-slate-100 hover:bg-slate-200 p-1 mr-1" href={data.category_slug}
              >#{data.category}</a
            >
            {
              tags.map((tag) => (
                <a rel="tag" href={tag.slug} class="bg-slate-100 p-1 hover:bg-slate-200 mr-1 ">
                  #{tag.name}
                </a>
              ))
            }
          </div>
        </div>

        <!-- Мета-информация -->

        <!-- Image Placeholder -->
        <div class="w-full bg-gray-200 rounded-md flex items-center justify-center mt-4">
          <!-- Картинка -->

          <Telepicture
            desktopImgUrl={data.featured_img_url}
            loading="eager"
            layout="constrained"
            wImg={891}
            hImg={501}
            class="aspect-[16/9] max-w-full block"
            posttitle={data.title}
          />
        </div>

        <!--  Subscribe Block -->
        <div class="bg-blue-50 border border-blue-200 p-4 mt-4 flex items-center space-x-4">
          <div class="w-10 h-10 rounded-full bg-blue-600 flex items-center justify-center"></div>
          <div>
            <h2 class="text-blue-700 font-semibold text-sm">Подпишитесь на Telegraf</h2>
            <p class="text-blue-600 text-sm">Новости в Telegram, Viber и других платформах.</p>
          </div>
        </div>
      </header>
      <section class="prose max-w-none prose-blue">
        <div id="lead-post" set:html={lidtHtml} />
        <!-- 📝 Article Text -->
        <div id="post-text" set:html={contentHtml} />
      </section>
      <section class="bg-white border-t border-gray-200 mt-12 pt-6">
        <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8">
          <h2 class="text-xl font-bold text-gray-900 mb-4">Подобрали для вас</h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- 🔹 Карточка 1 -->
            <a
              href="#"
              class="block bg-gray-50 border border-gray-200 rounded-md overflow-hidden hover:shadow-sm transition"
            >
              <div class="h-40 bg-gray-200 flex items-center justify-center">
                <svg
                  class="w-12 h-12 text-gray-400"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  ><rect x="3" y="3" width="18" height="14" rx="2" ry="2"></rect><path
                    d="M3 17l6-6 4 4 8-8"></path></svg
                >
              </div>
              <div class="p-4 space-y-2">
                <h3 class="text-base font-semibold text-gray-800 leading-snug">
                  Как постирать в стиралке без воды? На «АТЛАНТе»
                  подhttps://docs.astro.build/en/guides/integrations-guide/mdx/сказали способ
                </h3>
                <div class="text-sm text-gray-500">Лайфхаки • 23 июля 2025</div>
              </div>
            </a>

            <!-- 🔹 Карточка 2 -->
            <a
              href="#"
              class="block bg-gray-50 border border-gray-200 rounded-md overflow-hidden hover:shadow-sm transition"
            >
              <div class="h-40 bg-gray-200 flex items-center justify-center">
                <svg
                  class="w-12 h-12 text-gray-400"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  ><rect x="3" y="3" width="18" height="14" rx="2" ry="2"></rect><path
                    d="M3 17l6-6 4 4 8-8"></path></svg
                >
              </div>
              <div class="p-4 space-y-2">
                <h3 class="text-base font-semibold text-gray-800 leading-snug">
                  Почему крышечки на стаканчиках со сметаной стало не оторвать?
                </h3>
                <div class="text-sm text-gray-500">Еда • 21 июля 2025</div>
              </div>
            </a>

            <!-- 🔹 Карточка 3 -->
            <a
              href="#"
              class="block bg-gray-50 border border-gray-200 rounded-md overflow-hidden hover:shadow-sm transition"
            >
              <div class="h-40 bg-gray-200 flex items-center justify-center">
                <svg
                  class="w-12 h-12 text-gray-400"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  ><rect x="3" y="3" width="18" height="14" rx="2" ry="2"></rect><path
                    d="M3 17l6-6 4 4 8-8"></path></svg
                >
              </div>
              <div class="p-4 space-y-2">
                <h3 class="text-base font-semibold text-gray-800 leading-snug">
                  «Это нормально» — почему последняя минута стирки может длиться 5
                </h3>
                <div class="text-sm text-gray-500">Общество • 22 июля 2025</div>
              </div>
            </a>
          </div>
        </div>
      </section>
    </article>

    <!-- Sidebar -->
    <aside class="space-y-6">
      <!-- 💱 Currency Block -->
      <div class="bg-white border border-gray-200 p-4 rounded-md">
        <h2 class="text-lg font-semibold text-gray-700 mb-2">Курсы валют</h2>
        <ul class="text-sm text-gray-600 space-y-1">
          <li>USD: 3.25 BYN</li>
          <li>EUR: 3.55 BYN</li>
          <li>RUB: 0.034 BYN</li>
        </ul>
      </div>

      <!--   Weather Block -->
      <div class="bg-white border border-gray-200 p-4 rounded-md">
        <h2 class="text-lg font-semibold text-gray-700 mb-2">Погода</h2>
        <p class="text-sm text-gray-600">Бобруйск: +24°C, ясно</p>
        <p class="text-sm text-gray-600">Влажность: 45%, Ветер: 3 м/с</p>
      </div>

      <!--   News Feed -->
      <div class="bg-white border border-gray-200 p-4 rounded-md">
        <h2 class="text-lg font-semibold text-gray-700 mb-2">Последние новости</h2>
        <ul class="text-sm text-gray-600 space-y-2">
          <li>
            <a href="#" class="hover:text-blue-600">Как вернуть носкам белый цвет за 1 рубль</a>
          </li>
          <li><a href="#" class="hover:text-blue-600">Кому не стоит есть помидоры</a></li>
          <li>
            <a href="#" class="hover:text-blue-600">8 продуктов, от которых стоит отказаться</a>
          </li>
        </ul>
      </div>
    </aside>
  </main>
</NewsBase>
