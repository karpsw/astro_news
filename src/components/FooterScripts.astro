---
import CoookieConsent from '@/components/CoookieConsent.astro';
import Lightbox from '@/components/Telebox.astro';

//   Служебные скрипты
---

<script
  src="https://platform-api.sharethis.com/js/sharethis.js#property=5fad52bce3f5df0012a01974&product=inline-reaction-buttons"
  client:idle></script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // --- Мобильное меню ---
    const menuButton = document.getElementById('mobileMenuButton');
    const menuButtonСlose = document.getElementById('closeMenu');
    const mobileMenu = document.getElementById('mobileMenu');
    const overlay = document.getElementById('Overlay'); // общий оверлей
    const openIcon = document.querySelector('.menu-icon-open');
    const closeIcon = document.querySelector('.menu-icon-close');

    const isMenuOpen = () => !mobileMenu.classList.contains('-translate-x-full');
    const isSearchOpen = () => !searchPanel.classList.contains('hidden');

    function openMenu() {
      menuButton.setAttribute('aria-expanded', 'true');
      mobileMenu.classList.remove('-translate-x-full');
      openIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      overlay.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
    }

    function closeMenu() {
      menuButton.setAttribute('aria-expanded', 'false');
      mobileMenu.classList.add('-translate-x-full');
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      if (!isSearchOpen()) overlay.classList.add('hidden');
      document.body.classList.toggle('overflow-hidden', isSearchOpen());
    }

    if (menuButton) {
      menuButton.addEventListener('click', () => {
        if (isMenuOpen()) closeMenu();
        else {
          if (isSearchOpen()) closeSearch(); // если поиск открыт — закрыть
          openMenu();
        }
      });
    }

    if (menuButtonСlose) {
      menuButtonСlose.addEventListener('click', () => {
        if (isMenuOpen()) closeMenu();
        else {
          if (isSearchOpen()) closeSearch(); // если поиск открыт — закрыть
          openMenu();
        }
      });
    }

    // --- Поиск ---
    const searchPanel = document.getElementById('searchPanel');
    const searchForm = searchPanel.querySelector('div');
    const searchInput = searchPanel.querySelector('input[type="search"]');

    const openButtons = document.querySelectorAll('.open-search, #searchButton');
    const closeButtons = document.querySelectorAll('.close-search');

    function openSearch() {
      if (isMenuOpen()) closeMenu(); // закрыть меню если оно открыто
      overlay.classList.remove('hidden');
      searchPanel.classList.remove('hidden');
      requestAnimationFrame(() => {
        searchForm.classList.remove('scale-95', 'opacity-0');
        searchForm.classList.add('scale-100', 'opacity-100');
      });
      document.body.classList.add('overflow-hidden');
      searchInput?.focus();
    }

    function closeSearch() {
      searchForm.classList.remove('scale-100');
      searchForm.classList.add('scale-95', 'opacity-0');
      setTimeout(() => {
        searchPanel.classList.add('hidden');
        if (!isMenuOpen()) overlay.classList.add('hidden');
        document.body.classList.toggle('overflow-hidden', isMenuOpen());
      }, 300);
    }

    // Обработчики
    openButtons.forEach((btn) => btn.addEventListener('click', openSearch));
    closeButtons.forEach((btn) => btn.addEventListener('click', closeSearch));

    overlay.addEventListener('click', () => {
      if (isSearchOpen()) closeSearch();
      else if (isMenuOpen()) closeMenu();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (isSearchOpen()) closeSearch();
        else if (isMenuOpen()) closeMenu();
      }
    });
  });
</script>

<Lightbox />
<CoookieConsent />
