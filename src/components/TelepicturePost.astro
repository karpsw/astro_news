---
// Imports
import Telepicture from './Telepicture.astro';

import type { PostCardItem } from '@/schemas/post-card';
import type { SrcSets } from './Telepicture.astro';

export interface Props {
  post: PostCardItem;
  imgclass?: string;
  srcSets: SrcSets;
}

const { post, srcSets, imgclass = 'aspect-[16/9] max-w-full block' } = Astro.props;
---

{
  post.img && post.img.url && (
    <Telepicture
      src={post.img.url}
      loading="lazy"
      imgclass={imgclass}
      posttitle={post.title}
      alt={post.img.alt}
      lightbox="no"
      srcSets={srcSets}
    />
  )
}
