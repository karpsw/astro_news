---
import { decode } from 'html-entities'

import LabelPost, { LabelPostVariant } from '@/components/Labelpost.astro'
import { telDate } from '@/utils/datetime'
import TelepicturePost from './TelepicturePost.astro'

import type { PostCardItem } from '@/schemas/post-card'
import { wrapUrl } from '@/utils/urls'

export enum NewsPostCardLayout {
  variant1 = 'картинка снизу',
  variant2 = 'с лидом и датой фотка вверху',
  variant3 = 'без лида и даты фотка вверху',
  variant4 = 'фото слева большие блоки',
  variant5 = 'фото слева компактный',
}

export interface Props {
  post: PostCardItem;
  layout?: NewsPostCardLayout;
}

const { post, layout = NewsPostCardLayout.variant1 } = Astro.props;
---

{
  (() => {
    switch (layout) {
      case NewsPostCardLayout.variant1:
        return (
          <article class="bg-white rounded-lg shadow hover:shadow-md transition overflow-hidden relative">
            <h3 class="text-lg font-semibold text-gray-800 hover:text-blue-600 transition px-4 mb-4 pt-4">
              <a href={wrapUrl(post.url)}>{decode(post.title)}</a>
            </h3>
            <a href={wrapUrl(post.url)} class="block relative mb-0 pb-0">
              <TelepicturePost
                post={post}
                srcSets={{ desctop: { w: 434, h: 244 }, modile: { w: 380, h: 214 } }}
                imgclass="aspect-[16/9] w-full"
              />
              <LabelPost label={post.label} position="absolute bottom-0 left-0" />
            </a>
          </article>
        );
      case NewsPostCardLayout.variant2:
        return (
          <article class="bg-white rounded-lg shadow hover:shadow-md transition overflow-hidden">
            <a href={wrapUrl(post.url)} class="block relative">
              <TelepicturePost
                post={post}
                srcSets={{ desctop: { w: 434, h: 244 }, modile: { w: 380, h: 214 } }}
                imgclass="aspect-[16/9] w-full"
              />
              <LabelPost label={post.label} position="absolute bottom-0 left-0" />
            </a>
            <h3 class="text-lg font-semibold text-gray-800 hover:text-blue-600 transition px-4 pt-4 line-clamp-4">
              <a href={wrapUrl(post.url)}>{decode(post.title)}</a>
            </h3>
            {post.lid && (
              <p class="text-gray-700 text-sm mt-2 line-clamp-3 px-4 mb-4">
                <a href={wrapUrl(post.url)}>{decode(post.lid)} </a>
              </p>
            )}
             <p class="px-4 text-sm text-gray-500 mb-4">{telDate(new Date(post.pubDate!))}</p>
          </article>
        );
      case NewsPostCardLayout.variant3:
        return (
          <article class="bg-white rounded-lg shadow hover:shadow-md transition overflow-hidden">
            <a href={wrapUrl(post.url)} class="block relative">
              <TelepicturePost
                post={post}
                srcSets={{ desctop: { w: 434, h: 244 }, modile: { w: 380, h: 214 } }}
                imgclass="aspect-[16/9] w-full"
              />
              <LabelPost label={post.label} position="absolute bottom-0 left-0" />
            </a>
            <h3 class="text-lg font-semibold text-gray-800 hover:text-blue-600 transition p-4">
              <a href={wrapUrl(post.url)}>{decode(post.title)}</a>
            </h3>
          </article>
        );
      case NewsPostCardLayout.variant4:
        return (
          <article class="bg-white rounded-lg shadow hover:shadow-md transition overflow-hidden flex">
            <!-- Фото слева -->
            <div class="w-1/3 flex-shrink-0">
              <a href={wrapUrl(post.url)} class="block relative h-full">
                <TelepicturePost
                  post={post}
                  srcSets={{ desctop: { w: 147, h: 128 }, modile: { w: 126, h: 128 } }}
                  imgclass="aspect-[4/3] w-full h-full object-cover"
                />
              </a>
            </div>
            
            <!-- Контент справа -->
            <div class="w-2/3 p-3 flex flex-col">
              <!-- Заголовок и лейбл в одной строке -->
              <div class="flex items-start gap-2 mb-2">
                <h3 class="text-sm font-semibold text-gray-800 hover:text-blue-600 transition flex-1 line-clamp-4">
                  <a href={wrapUrl(post.url)}>{decode(post.title)}  <LabelPost label={post.label} variant={LabelPostVariant.outlined} position="static" /> </a>
                </h3>
               
              </div>
              
              <!-- Дополнительная информация (опционально) -->
              {post.pubDate && (
                <time class="text-xs text-gray-500 mt-auto">
                    {telDate(new Date(post.pubDate!))}
                </time>
              )}
            </div>
          </article>
        );
       case NewsPostCardLayout.variant5:
        return (
          <article class="bg-white transition overflow-hidden flex group hover:bg-gray-50 rounded">
            <!-- Фото слева (уменьшенная ширина) -->
            <div class="w-1/4 flex-shrink-0">
              <a href={wrapUrl(post.url)} class="block relative h-full">
                <TelepicturePost
                  post={post}
                  srcSets={{ desctop: { w: 110, h: 91 }, modile: { w: 95, h: 90 } }}
                  imgclass="w-full h-full object-cover"
                />
              </a>
            </div>
            
            <!-- Контент справа -->
            <div class="w-3/4 py-1 pl-2 pr-1 flex flex-col justify-center">
              <!-- Заголовок с увеличенным размером шрифта -->
              <h3 class=" text-base  md:text-sm  font-semibold text-gray-80 transition line-clamp-3 leading-tight">
                <a href={wrapUrl(post.url)} class="inline">
                  {decode(post.title)}
                  <LabelPost 
                    label={post.label} 
                    variant={LabelPostVariant.outlined} 
                    position="inline-block ml-1 align-middle" 
                    class="!px-1 !py-0 text-[10px]" 
                  />
                </a>
              </h3>
              
              <!-- Дата -->
              {post.pubDate && (
                <time class="text-[12px] text-gray-500 mt-1">
                  {telDate(new Date(post.pubDate!))}
                </time>
              )}
            </div>
          </article>
        );
      default:
        return null;
    }
  })()
}
