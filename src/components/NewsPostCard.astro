---
import { decode } from 'html-entities';

import Telepicture from '@/components/Telepicture.astro';
import { telDate } from '@/utils/datetime';

import type { PostCardItem } from '@/schemas/post-card';

export enum NewsPostCardLayout {
  varant1 = 'картинка снизу',
  varant2 = 'картинка сверху',
}

export interface Props {
  post: PostCardItem;
  layout?: NewsPostCardLayout;
}

const { post, layout = NewsPostCardLayout.varant1 } = Astro.props;
---

{
  (() => {
    switch (layout) {
      case NewsPostCardLayout.varant1:
        return (
          <a
            href={post.url}
            class="block bg-white rounded-lg overflow-hidden shadow hover:shadow-md transition"
          >
            {post.img && (
              <Telepicture
                desktopImgUrl={post.img.url}
                loading="lazy"
                layout="constrained"
                wImg={891}
                hImg={501}
                class="aspect-[16/9] max-w-full block"
                posttitle={post.title}
                alt={post.img.alt}
                lightbox="no"
              />
            )}

            <div class="p-4">
              <h3 class="text-lg font-semibold leading-snug text-gray-800 hover:text-blue-600 transition">
                {decode(post.title)}
              </h3>
            </div>
          </a>
        );
      case NewsPostCardLayout.varant2:
        return (
          <article class="bg-white rounded-lg shadow hover:shadow-md transition overflow-hidden">
            <a href="/news/slug" class="block">
              {post.img && (
                <Telepicture
                  desktopImgUrl={post.img.url}
                  loading="lazy"
                  layout="constrained"
                  wImg={891}
                  hImg={501}
                  class="aspect-[16/9] max-w-full block"
                  posttitle={post.title}
                  alt={post.img.alt}
                  lightbox="no"
                />
              )}

              <div class="p-4">
                <h3 class="text-lg font-semibold text-gray-800 hover:text-blue-600 transition">
                  {decode(post.title)}
                </h3>
                <p class="text-sm text-gray-500 mt-2">{telDate(new Date(post.pubDate!))}</p>
                {post.lid && (
                  <p class="text-gray-700 text-sm mt-2 line-clamp-3">{decode(post.lid)}</p>
                )}
              </div>
            </a>
          </article>
        );
      default:
        return null;
    }
  })()
}
