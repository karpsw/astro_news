---
import { decode } from 'html-entities';

import LabelPost from '@/components/Labelpost.astro';
import { telDate } from '@/utils/datetime';
import TelepicturePost from './TelepicturePost.astro';

import type { PostCardItem } from '@/schemas/post-card';

export enum NewsPostCardLayout {
  variant1 = 'картинка снизу',
  variant2 = 'картинка сверху',
}

export interface Props {
  post: PostCardItem;
  layout?: NewsPostCardLayout;
}

const { post, layout = NewsPostCardLayout.variant1 } = Astro.props;
---

{
  (() => {
    switch (layout) {
      case NewsPostCardLayout.variant1:
        return (
          <a
            href={post.url}
            class="block bg-white rounded-lg overflow-hidden shadow hover:shadow-md transition"
          >
            <TelepicturePost
              post={post}
              srcSets={{ desctop: { w: 300, h: 200 }, modile: { w: 280, h: 190 } }}
              imgclass="aspect-[16/9] max-w-full block"
            />

            <LabelPost label={post.label} />

            <div class="p-4">
              <h3 class="text-lg font-semibold leading-snug text-gray-800 hover:text-blue-600 transition">
                {decode(post.title)}
              </h3>
            </div>
          </a>
        );
      case NewsPostCardLayout.variant2:
        return (
          <article class="bg-white rounded-lg shadow hover:shadow-md transition overflow-hidden">
            <head>
              <div class="relative">
                <TelepicturePost
                  post={post}
                  srcSets={{ desctop: { w: 300, h: 200 }, modile: { w: 280, h: 190 } }}
                  imgclass="aspect-[16/9] max-w-full block"
                />

                <LabelPost label={post.label} position="absolute bottom-0 left-0" />
              </div>
            </head>

            <a href="/news/slug" class="block">
              <div class="p-4">
                <h3 class="text-lg font-semibold text-gray-800 hover:text-blue-600 transition">
                  {decode(post.title)}
                </h3>
                <p class="text-sm text-gray-500 mt-2">{telDate(new Date(post.pubDate!))}</p>
                {post.lid && (
                  <p class="text-gray-700 text-sm mt-2 line-clamp-3">{decode(post.lid)}</p>
                )}
              </div>
            </a>
          </article>
        );
      default:
        return null;
    }
  })()
}
