---
import { getImage } from 'astro:assets';

import type { ImageMetadata } from 'astro';

interface Props {
  mobileImgUrl: string | ImageMetadata;
  mediumImgUrl: string | ImageMetadata;
  desktopImgUrl: string | ImageMetadata;
  alt?: string;
  wImg?: string;
  hImg?: string;
  loading?: string;
  fetchpriority?: string;
  decoding?: string;
  layout?: string;
  imgclass?: string;
}

const {
  desktopImgUrl,
  alt,
  wImg = '891',
  hImg = '501',
  loading = 'lazy',
  fetchpriority = 'auto',
  decoding = 'async',
  layout = 'constrained',
  imgclass = 'w-full',
} = Astro.props;

const mobileImg = await getImage({
  src: desktopImgUrl + '?w=382&h=221&crop=1',
  width: 382,
  height: 221,
});

const mediumImgUrl = await getImage({
  src: desktopImgUrl + '?w=690&h=397&crop=1',
  width: 690,
  height: 397,
});

const desktopImg = await getImage({
  src: desktopImgUrl + '?w=' + wImg + '&h=' + hImg + '&crop=1',
  width: wImg,
  height: hImg,
});
---

<picture>
  <source media="(max-width: 799px)" srcset={mobileImg.src} />
  <source media="(min-width: 800px) and (max-width: 1200px)" srcset={mediumImgUrl.src} />
  <source media="(min-width: 1201px)" srcset={desktopImg.src} />
  <img
    src={desktopImg.src}
    alt={alt}
    loading={loading}
    decoding={decoding}
    fetchpriority={fetchpriority}
    class={imgclass}
  />
</picture>
