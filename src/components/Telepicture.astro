---
import { getImage } from 'astro:assets';

import sanitizeHtml from 'sanitize-html';

import type { ImageMetadata } from 'astro';

interface Props {
  mobileImgUrl: string | ImageMetadata;
  mediumImgUrl: string | ImageMetadata;
  desktopImgUrl: string | ImageMetadata;
  alt?: string;
  wImg?: string;
  hImg?: string;
  loading?: string;
  fetchpriority?: string;
  decoding?: string;
  layout?: string;
  imgclass?: string;
  caption?: string;
  posttitle?: string;
}

const {
  desktopImgUrl,
  alt = '',
  wImg = '891',
  hImg = '501',
  loading = 'lazy',
  fetchpriority = 'auto',
  decoding = 'async',
  layout = 'constrained',
  imgclass = 'w-full',
  caption,
  posttitle = '',
} = Astro.props;

// Проверяем наличие desktopImgUrl
if (!desktopImgUrl) {
  return null; // Ничего не показываем если нет изображения
}

// Определяем alt-текст с очисткой
const finalAlt = sanitizeHtml(alt || caption || posttitle);

const mobileImg = await getImage({
  src: desktopImgUrl + '?w=382&h=221&crop=1',
  width: 382,
  height: 221,
});

const mediumImg = await getImage({
  src: desktopImgUrl + '?w=690&h=397&crop=1',
  width: 690,
  height: 397,
});

const desktopImg = await getImage({
  src: desktopImgUrl + '?w=' + wImg + '&h=' + hImg + '&crop=1',
  width: parseInt(wImg),
  height: parseInt(hImg),
});
---

{
  !caption ? (
    <picture>
      <source media="(max-width: 799px)" srcset={mobileImg.src} />
      <source media="(min-width: 800px) and (max-width: 1200px)" srcset={mediumImg.src} />
      <source media="(min-width: 1201px)" srcset={desktopImg.src} />
      <img
        width={wImg}
        height={hImg}
        src={desktopImg.src}
        alt={finalAlt}
        loading={loading}
        decoding={decoding}
        fetchpriority={fetchpriority}
        class={imgclass}
      />
    </picture>
  ) : (
    <figure>
      <picture>
        <source media="(max-width: 799px)" srcset={mobileImg.src} />
        <source media="(min-width: 800px) and (max-width: 1200px)" srcset={mediumImg.src} />
        <source media="(min-width: 1201px)" srcset={desktopImg.src} />
        <img
          width={wImg}
          height={hImg}
          src={desktopImg.src}
          alt={finalAlt}
          loading={loading}
          decoding={decoding}
          fetchpriority={fetchpriority}
          class={imgclass}
        />
      </picture>
      <figcaption>{caption}</figcaption>
    </figure>
  )
}
