---
// Imports

import sanitizeHtml from 'sanitize-html';

type SrcSetImg = { w: number; h: number };

export type SrcSets = {
  desctop: SrcSetImg;
  modile?: SrcSetImg;
  medium?: SrcSetImg;
};

// Props
interface Props {
  src: string;
  alt?: string;
  className?: string;
  loading?: 'lazy' | 'eager' | null | undefined;
  fetchpriority?: 'auto' | 'high' | 'low' | null | undefined;
  decoding?: 'auto' | 'async' | 'sync' | null | undefined;
  //layout?: string;
  imgclass?: string;
  caption?: string;
  posttitle?: string;
  lightbox?: 'yes' | 'no';
  srcSets: SrcSets;
}

const {
  src,
  alt = '',
  loading = 'lazy',
  fetchpriority = 'auto',
  decoding = 'async',
  //layout = 'constrained',
  imgclass = 'w-full',
  caption,
  posttitle = '',
  lightbox = 'no',
  srcSets = { desctop: { w: 891, h: 501 } } as SrcSets,
} = Astro.props;

// Если нет desktopImgUrl — ничего не показываем
if (!src) {
  return null;
}

// Динамический атрибут lightbox
const lightboxAttr = lightbox === 'yes' ? { 'data-lightbox': '' } : {};

// Alt текст с очисткой
const finalAlt = sanitizeHtml(alt || caption || posttitle);

// Генерация изображений через Astro
---

{
  !caption ? (
    <picture>
      {srcSets.modile && (
        <source
          media="(max-width: 799px)"
          srcset={`${src}?w=${srcSets.modile.w}&h=${srcSets.modile.h}&crop=1`}
        />
      )}
      {srcSets.medium && (
        <source
          media="(min-width: 800px) and (max-width: 1200px)"
          srcset={`${src}?w=${srcSets.medium.w}&h=${srcSets.medium.h}&crop=1`}
        />
      )}
      {srcSets.desctop && (
        <source
          media="(min-width: 1201px)"
          srcset={`${src}?w=${srcSets.desctop.w}&h=${srcSets.desctop.h}&crop=1`}
        />
      )}

      <img
        width={srcSets.desctop.w}
        height={srcSets.desctop.h}
        src={
          srcSets.desctop
            ? `${src}?w=${srcSets.desctop.w}&h=${srcSets.desctop.h}&crop=1`
            : `${src}?w=${891}&h=${501}&crop=1`
        }
        alt={finalAlt}
        loading={loading}
        decoding={decoding}
        fetchpriority={fetchpriority}
        class={imgclass}
        {...lightboxAttr}
      />
    </picture>
  ) : (
    <figure>
      <picture>
        {srcSets.modile && (
          <source
            media="(max-width: 799px)"
            srcset={`${src}?w=${srcSets.modile.w}&h=${srcSets.modile.h}&crop=1`}
          />
        )}
        {srcSets.medium && (
          <source
            media="(min-width: 800px) and (max-width: 1200px)"
            srcset={`${src}?w=${srcSets.medium.w}&h=${srcSets.medium.h}&crop=1`}
          />
        )}
        {srcSets.desctop && (
          <source
            media="(min-width: 1201px)"
            srcset={`${src}?w=${srcSets.desctop.w}&h=${srcSets.desctop.h}&crop=1`}
          />
        )}
        <img
          width={srcSets.desctop.w}
          height={srcSets.desctop.h}
          src={`${src}?w=${srcSets.desctop.w}&h=${srcSets.desctop.h}&crop=1`}
          alt={finalAlt}
          loading={loading}
          decoding={decoding}
          fetchpriority={fetchpriority}
          class={imgclass}
          {...lightboxAttr}
        />
      </picture>
      <figcaption>{caption}</figcaption>
    </figure>
  )
}
