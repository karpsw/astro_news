---
// Imports

import sanitizeHtml from 'sanitize-html';

// Props
interface Props {
  src: string;
  alt?: string;
  className?: string;
  wImg?: number;
  hImg?: number;
  loading?: 'lazy' | 'eager' | null | undefined;
  fetchpriority?: 'auto' | 'high' | 'low' | null | undefined;
  decoding?: 'auto' | 'async' | 'sync' | null | undefined;
  //layout?: string;
  imgclass?: string;
  caption?: string;
  posttitle?: string;
  lightbox?: 'yes' | 'no';
}

const {
  src,
  alt = '',
  wImg = 891,
  hImg = 501,
  loading = 'lazy',
  fetchpriority = 'auto',
  decoding = 'async',
  //layout = 'constrained',
  imgclass = 'w-full',
  caption,
  posttitle = '',
  lightbox = 'no',
} = Astro.props;

// Если нет desktopImgUrl — ничего не показываем
if (!src) {
  return null;
}

// Динамический атрибут lightbox
const lightboxAttr = lightbox === 'yes' ? { 'data-lightbox': '' } : {};

// Alt текст с очисткой
const finalAlt = sanitizeHtml(alt || caption || posttitle);

type DeviceImageData = {
  src: string;
  width: number;
  height: number;
};

// Генерация изображений через Astro
const mobileImg: DeviceImageData = {
  src: src + '?w=382&h=221&crop=1',
  width: 382,
  height: 221,
};

const mediumImg: DeviceImageData = {
  src: src + '?w=690&h=397&crop=1',
  width: 690,
  height: 397,
};

const desktopImg: DeviceImageData = {
  src: `${src}?w=${wImg}&h=${hImg}&crop=1`,
  width: wImg!,
  height: hImg,
};
---

{
  !caption ? (
    <picture>
      <source media="(max-width: 799px)" srcset={mobileImg.src} />
      <source media="(min-width: 800px) and (max-width: 1200px)" srcset={mediumImg.src} />
      <source media="(min-width: 1201px)" srcset={desktopImg.src} />
      <img
        width={wImg}
        height={hImg}
        src={desktopImg.src}
        alt={finalAlt}
        loading={loading}
        decoding={decoding}
        fetchpriority={fetchpriority}
        class={imgclass}
        {...lightboxAttr}
      />
    </picture>
  ) : (
    <figure>
      <picture>
        <source media="(max-width: 799px)" srcset={mobileImg.src} />
        <source media="(min-width: 800px) and (max-width: 1200px)" srcset={mediumImg.src} />
        <source media="(min-width: 1201px)" srcset={desktopImg.src} />
        <img
          width={wImg}
          height={hImg}
          src={desktopImg.src}
          alt={finalAlt}
          loading={loading}
          decoding={decoding}
          fetchpriority={fetchpriority}
          class={imgclass}
          {...lightboxAttr}
        />
      </picture>
      <figcaption>{caption}</figcaption>
    </figure>
  )
}
