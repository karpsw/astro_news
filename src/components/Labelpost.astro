---
import { Icon } from 'astro-icon/components';

export enum LabelPostVariant {
  filled = 'filled', // Красный фон, белый текст - div
  outlined = 'outlined', // Красный текст, прозрачный фон, красная рамка - span
}

interface Props {
  label?: string; // Делаем опциональным
  position?: string; // класс для позиционирования в блоке
  variant?: LabelPostVariant; // Вариант дизайна
}

const { label, position = 'static', variant = LabelPostVariant.filled } = Astro.props;

// Проверяем, существует ли label и он не пустой
const hasLabel = label && label.trim().length > 0;

// Функция для проверки содержания слов в label
const getLabelInfo = (labelText: string) => {
  const lowerLabel = labelText.toLowerCase();

  let iconName = null;
  let searchWord = '';

  if (lowerLabel.includes('полезно')) {
    iconName = 'mdi:thumb-up';
    searchWord = 'Полезно';
  } else if (lowerLabel.includes('фото')) {
    iconName = 'mdi:camera';
    searchWord = 'Фото';
  } else if (lowerLabel.includes('видео')) {
    iconName = 'mdi:video';
    searchWord = 'Видео';
  } else if (lowerLabel.includes('обновлено')) {
    iconName = 'mdi:sync-circle';
    searchWord = 'Обновлено';
  } else if (lowerLabel.includes('официально')) {
    iconName = 'mdi:briefcase-variant';
    searchWord = 'Официально';
  } else if (lowerLabel.includes('неофициально')) {
    iconName = 'mdi:incognito-circle';
    searchWord = 'Неофициально';
  } else if (lowerLabel.includes('срочно')) {
    iconName = 'mdi:fire-circle';
    searchWord = 'Срочно';
  } else if (lowerLabel.includes('анализ')) {
    iconName = 'mdi:chart-bar';
    searchWord = 'Анализ';
  } else if (lowerLabel.includes('партнёрский') || lowerLabel.includes('партнерский')) {
    iconName = 'mdi:hand-shake';
    searchWord = 'Партнёрский';
  } else if (lowerLabel.includes('мнение')) {
    iconName = 'mdi:microphone';
    searchWord = 'Мнение';
  } else if (lowerLabel.includes('тест')) {
    iconName = 'mdi:head-question';
    searchWord = 'Тест';
  }

  return { iconName, searchWord };
};

// Получаем информацию о label только если он существует
const labelInfo = hasLabel ? getLabelInfo(label) : { iconName: null, searchWord: '' };

// Определяем классы в зависимости от варианта
const getVariantClasses = () => {
  switch (variant) {
    case LabelPostVariant.outlined:
      return 'ml-1 inline-block text-tel-red';
    case LabelPostVariant.filled:
    default:
      return 'px-2 py-1 bg-tel-red text-white flex flex-nowrap ';
  }
};
---

{
  hasLabel &&
    (() => {
      const commonClasses = ` justify-center items-center  ${position} ${getVariantClasses()}`;

      switch (variant) {
        case LabelPostVariant.outlined:
          return (
            <span class={commonClasses}>
              {labelInfo.iconName && (
                <Icon name={labelInfo.iconName} class="text-sm inline mr-1 pb-[0.1rem]" />
              )}
              {labelInfo.searchWord}
            </span>
          );
        case LabelPostVariant.filled:
        default:
          return (
            <div class={commonClasses}>
              {labelInfo.iconName && <Icon name={labelInfo.iconName} class="text-base mr-1" />}
              {labelInfo.searchWord}
            </div>
          );
      }
    })()
}
