---
import '@/styles/main.css';
import '@fontsource-variable/inter/index.css';

import { ClientRouter } from 'astro:transitions';

import { decode } from 'html-entities';

import ThemeScript from '@/components/ThemeScript.astro';
import { CONFIG_CLIENT } from '@/config/client';

import type { zMetaHead } from '@/schemas/meat-head';
import type { NewsArticle, WithContext } from 'schema-dts';
import type z from 'zod';

const { PLAUSIBLE_SCRIPT_URL, PLAUSIBLE_DOMAIN } = CONFIG_CLIENT;

// set defualt metadata in this component
//const { data } = Astro.props;
const { data } = Astro.props as { data: z.infer<typeof zMetaHead> };
const { tags } = data;
const decodedTitle = decode(data.head_title);
const decodedTitle2 = decodeHtml(decodedTitle);

function decodeHtml(html) {
  let plainText = html.replace(/&quot;/, '"');
  return plainText;
}

const authorName = data.avtor_name?.trim() ? data.avtor_name : 'Редакция Telegraf.news';
const authortype = data.avtor_name?.trim() ? 'Person' : 'Organization';

const structuredData: WithContext<NewsArticle> = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': data.head_canonical,
  },
  headline: decodedTitle2,
  image: data.head_og_image,
  datePublished: data.date,
  articleSection: data.category,
  author: {
    '@type': authortype,
    name: authorName,
    url: 'https://telegraf.news/redakciya/',
  },
  publisher: {
    '@type': 'Organization',
    name: 'ЧИУП Агентство Телеграф',
    logo: {
      '@type': 'ImageObject',
      url: 'https://telegraf.news/file/2022/07/Telegraf.news-C.png',
    },
  },
  description: data.head_description,
};
---

<head>
  {/* Global Metadata */}
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />

  <meta name="theme-color" content="" />
  <title>{decodedTitle2}</title>
  <meta name="description" content={data.head_description} />
  <meta name="robots" content={data.head_robots} />
  <link rel="canonical" href={data.head_canonical} />
  <meta property="og:locale" content="ru_BY" />
  <meta property="og:type" content={data.head_og_type} />
  <meta property="og:title" content={data.head_og_title} />
  <meta property="og:description" content={data.head_og_description} />
  <meta property="og:url" content={data.head_og_url} />
  <meta property=" og:site_name" content={data.head_og_site_name} />
  <meta property="article:section" content={data.head_article_section} />
  <meta property="og:image" content={data.head_og_image} />
  <meta property="og:image:secure_url" content={data.head_og_image_secure_url} />
  <meta property="og:image:width" content={data.head_og_image_width} />
  <meta property="og:image:height" content={data.head_og_image_height} />
  <meta property="og:image:alt" content={data.head_og_image_alt} />
  <meta property="og:image:type" content={data.head_og_image_type} />
  {
    tags &&
      tags.length > 0 &&
      tags.map((tag) => tag && tag.name && <meta property="article:tag" content={tag.name} />)
  }
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={data.head_twitter_title} />
  <meta name="twitter:description" content={data.head_twitter_description} />
  <meta name="twitter:image" content={data.head_twitter_image} />

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  {/* Analytics */}
  {
    PLAUSIBLE_SCRIPT_URL && (
      <>
        <link rel="preconnect" href={PLAUSIBLE_SCRIPT_URL} />
        {/* PLAUSIBLE_DOMAIN must be the same for all mirrors */}
        <script
          defer
          type="text/partytown"
          src={PLAUSIBLE_SCRIPT_URL}
          data-domain={PLAUSIBLE_DOMAIN}
        />
      </>
    )
  }

  {/* Theme */}
  {/* MUST be inside <head /> to avoid white flash, IMPORTANT */}
  <ThemeScript />

  <ClientRouter fallback="none" />

  <!-- 
    <style>
    @view-transition {
      navigation: auto; /* enabled! */
    }
    </style> 
  -->
</head>
