---
import '@/styles/main.css'
import '@fontsource-variable/inter/index.css'

import { ClientRouter } from 'astro:transitions'

import { decode } from 'html-entities'

import ThemeScript from '@/components/ThemeScript.astro'
import { CONFIG_CLIENT } from '@/config/client'

import '@/assets/styles/global.css'

import { zNewsPostSchema } from '@/schemas/archive'
import { zMetaHead } from '@/schemas/meat-head'

import type { NewsArticle, WithContext } from 'schema-dts'
import HtmlHead from 'Reklama/HtmlHead.astro'

const { data }: { data: unknown } = Astro.props;

//показывать рекламу или нет
const vyklReklama = data.vyklreklama;

const parsedMeta = zMetaHead.safeParse(data);
const parsedNews = zNewsPostSchema.safeParse(data);

const { PLAUSIBLE_SCRIPT_URL, PLAUSIBLE_DOMAIN } = CONFIG_CLIENT;

// set defualt metadata in this component
//const { data } = Astro.props;
const decodedTitle = parsedMeta.success ? decode(parsedMeta.data.head_title) : 'Telegraf.news';
const decodedTitle2 = decodeHtml(decodedTitle);

function decodeHtml(html) {
  let plainText = html.replace(/&quot;/, '"');
  return plainText;
}

const structuredData: WithContext<NewsArticle> | any = parsedNews.success
  ? {
      '@context': 'https://schema.org',
      '@type': 'NewsArticle',
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': parsedNews.data.head_canonical,
      },
      headline: decodedTitle2,
      image: parsedNews.data.head_og_image,
      datePublished: parsedNews.data.date,
      articleSection: parsedNews.data.category,
      author: {
        '@type': parsedNews.data.avtor_name?.trim() ? 'Person' : 'Organization',
        name: parsedNews.data.avtor_name?.trim()
          ? parsedNews.data.avtor_name
          : 'Редакция Telegraf.news',
        url: 'https://telegraf.news/redakciya/',
      },
      publisher: {
        '@type': 'Organization',
        name: 'ЧИУП Агентство Телеграф',
        logo: {
          '@type': 'ImageObject',
          url: 'https://telegraf.news/file/2022/07/Telegraf.news-C.png',
        },
      },
      description: parsedNews.data.head_description,
    }
  : {};
---

<head>
  {/* Global Metadata */}
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="icon" href="/images/favicons/favicon.png" type="image/x-icon">
  <link rel="shortcut icon" href="/images/favicons/favicon.png" type="image/x-icon">
  <meta name="theme-color" content="rgb(12, 12, 12)" />
  {
    parsedMeta.success && (
      <>
        <title>{decodedTitle2}</title>
        <meta name="description" content={parsedMeta.data.head_description} />
        <meta name="robots" content={parsedMeta.data.head_robots} />
        <link rel="canonical" href={parsedMeta.data.head_canonical} />
        <meta property="og:locale" content="ru_BY" />
        <meta property="og:type" content={parsedMeta.data.head_og_type} />
        <meta property="og:title" content={parsedMeta.data.head_og_title} />
        <meta property="og:description" content={parsedMeta.data.head_og_description} />
        <meta property="og:url" content={parsedMeta.data.head_og_url} />
        <meta property=" og:site_name" content={parsedMeta.data.head_og_site_name} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={parsedMeta.data.head_twitter_title} />
        <meta name="twitter:description" content={parsedMeta.data.head_twitter_description} />

        {parsedMeta.data.head_twitter_image && (
          <meta name="twitter:image" content={parsedMeta.data.head_twitter_image} />
        )}
      </>
    )
  }

  {
    parsedNews.success && (
      <>
        <meta property="article:section" content={parsedNews.data.head_article_section} />
        <meta property="og:image" content={parsedNews.data.head_og_image} />
        <meta property="og:image:secure_url" content={parsedNews.data.head_og_image_secure_url} />
        {parsedNews.data.head_og_image_width && (
          <meta property="og:image:width" content=`${parsedNews.data.head_og_image_width}` />
        )}
        {parsedNews.data.head_og_image_height && (
          <meta property="og:image:height" content=`${parsedNews.data.head_og_image_height}` />
        )}

        <meta property="og:image:alt" content={parsedNews.data.head_og_image_alt} />
        <meta property="og:image:type" content={parsedNews.data.head_og_image_type} />

        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

        {parsedNews.data.tags &&
          parsedNews.data.tags.length > 0 &&
          parsedNews.data.tags.map(
            (tag) => tag && tag.name && <meta property="article:tag" content={tag.name} />
          )}
      </>
    )
  }

  {/* Analytics */}
  {
    PLAUSIBLE_SCRIPT_URL && (
      <>
        <link rel="preconnect" href={PLAUSIBLE_SCRIPT_URL} />
        {/* PLAUSIBLE_DOMAIN must be the same for all mirrors */}
        <script
          defer
          type="text/partytown"
          src={PLAUSIBLE_SCRIPT_URL}
          data-domain={PLAUSIBLE_DOMAIN}
        />
      </>
    )
  }
  <meta name="takprodam-verification" content="a0a3a9fd-1d86-4a90-afc5-76906195de80">
  <meta name="verified-code" content="2073ad8b-76de-45ab-a836-f3d8801a7b88">
  <meta name='Petal-Search-site-verification' content='635c34838c'/>
  <meta name="yandex-verification" content="53f08bc9160e63c3" />
  <meta name="zen-verification" content="iMKSBpj8qB5TFKwySWdVNq2rSoMv0SYJkgB1qzsmMLcKDfAM9FNC452Wpnf6eOGm" />
  <meta name="wmail-verification" content="18350c8976987710b8c0311408667d6f" />
  <meta name="verify-admitad" content="042f1deaf1" />
  <meta name="recreativ-verification" content="yIBfi5mQygNUhBJaW2Mu22DVs7YqBVCaXZ7SsweS" >
  <meta name="adlane" content="adc020b208eb2bf4c72605be9fd07c7a">
  <meta name="propeller" content="1e609f4c9b78f88558d5594b6705dcd7">
  <meta name="clckd" content="69a60fb85b21e8e7eaaa21bb8f1cfda5" />
  <meta name="pmail-verification" content="343af00a41fc49694d36c8fed9fed5e7">
  <meta name="yandex-verification" content="aa13d5ad2ccb3319" />
  <meta name="verify-admitad" content="21013d433a" />

  <ClientRouter fallback="none" />

    <!-- Пикачу -->
   {!vyklReklama && <HtmlHead />}   
  

</head>
