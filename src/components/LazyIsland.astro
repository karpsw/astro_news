---
const { url = '/fragments/lazy-block' } = Astro.props;
---

<div class="lazy-island" data-url={url}>
  <div class="lazy-fallback"><slot /></div>
</div>

<script>
  const observer = new IntersectionObserver((entries, obs) => {
    entries.forEach(async (entry) => {
      if (entry.isIntersecting) {
        const el = entry.target;
        const url = el.dataset.url;

        try {
          const res = await fetch(url);
          if (!res.ok) throw new Error(`Ошибка загрузки: ${res.status}`);

          const html = await res.text();
          const wrapper = document.createElement('div');
          wrapper.className = 'lazy-content';
          wrapper.innerHTML = html;

          const fallback = el.querySelector('.lazy-fallback');
          if (fallback) setTimeout(() => fallback.remove(), 500);

          el.appendChild(wrapper);
          el.classList.add('loaded');
        } catch (err) {
          el.innerHTML += `<div style="color:red">Ошибка загрузки</div>`;
        }

        obs.unobserve(el); // отключаем наблюдение для этого элемента
      }
    });
  });

  document.querySelectorAll('.lazy-island').forEach((el) => observer.observe(el));
</script>
