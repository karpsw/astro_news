---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';

import Podpiska from '@/components/Podpiska.astro';
import { IMAGE_SIZES } from '@/constants/image';
import { CONFIG_CLIENT } from '@/config/client';
import { wrapUrl } from '@/utils/urls';

import Avatar from '@/assets/images/logotelegrafbel.svg';

const SiteUrl = wrapUrl(CONFIG_CLIENT.SITE_URL);

// components/SiteFooter.astro
const currentYear = new Date().getFullYear();
---

<footer class="bg-tel-black text-white mt-5" role="contentinfo">
  <div class="container py-7">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
      <!-- Левая колонка -->
      <div class="md:w-1/2 mb-4 md:mb-0 gap-4">
        <div class="flex items-center mb-4">
          <a href={SiteUrl} class="inline-block">
            <Image
              {...IMAGE_SIZES.FIXED.AVATAR}
              loading="lazy"
              class="shrink-0 select-none mr-2"
              src={Avatar}
              alt="Telegraf.news"
            />
          </a>
          <button id="closeSearch2" class="open-search inline-block">
            <Icon name="mdi:magnify" class="text-white text-xl" />
          </button>
        </div>
        <p class="text-sm text-white">
          &copy; 2005 - {currentYear} Телеграф - новости Беларуси и мира.
        </p>
        <p class="text-xs">
          При использовании информации Telegraf.news активная ссылка обязательна
        </p>

        <div class="text-xs text-white space-y-1 mt-4">
          <p>ЧИУП «АГЕНТСТВО «ТЕЛЕГРАФ». УНП: 191309537</p>
          <p>220035, г. Минск, ул. Тимирязева, д. 65Б</p>
          <p>В Реестре рекламораспространителей МАРТ РБ: 1398</p>

          <p>E-mail рекламного отдела: reklama@telegraf.news</p>
        </div>
      </div>

      <!-- Правая колонка -->
      <div class="md:w-1/2">
        <!-- Навигация -->
        <nav class="flex flex-wrap gap-4 mb-4 md:justify-end">
          <a href="/pravila/" class="text-sm text-white hover:text-red-600 transition-colors">
            Политика конфиденциальности
          </a>
          <a
            href="/informaciya-o-sajte/"
            class="text-sm text-white hover:text-red-600 transition-colors"
          >
            Контакты
          </a>
          <a href="/redakciya/" class="text-sm text-white hover:text-red-600 transition-colors">
            О сайте
          </a>
        </nav>

        <!-- Социальные сети -->
        <!--  Subscribe Block -->
        <Podpiska theme="black" title="Телеграф в соцсетях:" />
      </div>
    </div>
  </div>
</footer>
