---
import { Icon } from 'astro-icon/components';
---

<div class="share-buttons flex items-center justify-start">
  <div class="flex items-center justify-between mr-2 px-2 h-[40px] bg-stone-100">
    <span class="mr-2 text-gray-600 text-sm">Репосты:</span>
    <span class="count-share font-semibold">10</span>
  </div>
  <button
    class="share-general mr-2 flex items-center justify-center rounded shareb h-[40px] w-[40px] bg-orange-400"
    ><Icon name="mdi:share-variant" class="text-3xl" /></button
  >
  <a
    class="share-telegram mr-2 shareb flex items-center justify-center rounded shareb h-[40px] w-[40px] bg-orange-400"
    href="#"
    target="_blank"
    rel="noopener noreferrer"><Icon name="simple-icons:telegram" class="text-3xl" /></a
  >
  <a
    class="share-viber mr-2 shareb flex items-center justify-center rounded shareb h-[40px] w-[40px] bg-orange-400"
    href="#"><Icon name="simple-icons:viber" class="text-3xl" /></a
  >
  <a
    class="share-vk mr-2 shareb flex items-center justify-center rounded shareb h-[40px] w-[40px] bg-orange-400"
    href="#"
    target="_blank"
    rel="noopener noreferrer"><Icon name="simple-icons:vk" class="text-3xl" /></a
  >
  <a
    class="share-ok mr-2 shareb flex items-center justify-center rounded shareb h-[40px] w-[40px] bg-orange-400"
    href="#"
    target="_blank"
    rel="noopener noreferrer"><Icon name="simple-icons:odnoklassniki" class="text-3xl" /></a
  >
  <a
    class="share-whatsapp mr-2 shareb flex items-center justify-center rounded shareb h-[40px] w-[40px] bg-orange-400"
    href="#"
    target="_blank"
    rel="noopener noreferrer"><Icon name="simple-icons:whatsapp" class="text-3xl" /></a
  >
</div>
