---
import type { NadvorDto, CityWeather, CityWeatherError } from '@/modules/wp-api-types';
import { Tabs } from 'astro-tabs';
 import NadvoreCityPanel from '@/components/Widgets/NadvoreCityPanel.astro';
const { nadvore }: { nadvore?: NadvorDto } = Astro.props;

export const extractDate = (raw: string): string => {
  const match = raw.match(/^\d{2}\.\d{2}\.\d{4}/);
  return match ? match[0] : '';
};

const cities = nadvore?.data ? Object.entries(nadvore.data) : [];
 

---



{nadvore && cities.length > 0 ? (
  <div class="bg-white border border-gray-200 p-4 rounded-md mb-5">
    <h3 class="text-md font-semibold text-gray-700 mb-2">Погода по городам</h3>
    <p class="text-xs text-gray-500 mb-4">Обновлено: {nadvore.last_updated}</p>


<Tabs>
  	<Fragment slot={`tab-1`}>Минск</Fragment>
		<Fragment slot={`panel-1`}>
			<NadvoreCityPanel city={nadvore.data['Minsk'] as CityWeather} />
		</Fragment>

		<Fragment slot={`tab-2`}>Гомель</Fragment>
		<Fragment slot={`panel-2`}>
			<NadvoreCityPanel city={nadvore.data['Brest'] as CityWeather} />
		</Fragment>

		<Fragment slot={`tab-3`}>Гродно</Fragment>
		<Fragment slot={`panel-3`}>
			<NadvoreCityPanel city={nadvore.data['Harodnia'] as CityWeather} />
		</Fragment>
</Tabs>


 

    <!-- Контент -->
    <div id="weather-tabs-content">


      {cities.map(([cityKey, city], i) => (
        <div
          id={`panel-${cityKey}`}
          role="tabpanel"
          aria-labelledby={`tab-${cityKey}`}
          class={`${i === 0 ? 'block' : 'hidden'} p-4 bg-gray-50 border border-gray-200 rounded-md`}
        >
          {'error' in city ? (
            <p class="text-red-600">Ошибка: {(city as CityWeatherError).error}</p>
          ) : (
            <div>
              <div class="flex items-center gap-3 mb-3">
                <img src={(city as CityWeather).current.icon} alt="" />
                <div>
                  <p class="text-lg font-semibold">{(city as CityWeather).name}</p>
                  <p class="text-gray-600">{(city as CityWeather).current.condition}</p>
                </div>
              </div>

              <div class="grid grid-cols-3 gap-4 text-sm">
                <div class="p-2 border rounded shadow-sm">
                  <p class="font-medium">Сейчас</p>
                  <p>{(city as CityWeather).current.temperature}</p>
                  <p>Ощущается: {(city as CityWeather).current.feels_like}</p>
                  <p>Ветер: {(city as CityWeather).current.wind.speed} м/с</p>
                  <p>Влажность: {(city as CityWeather).current.humidity}%</p>
                </div>

                <div class="p-2 border rounded shadow-sm">
                  <p class="font-medium">Завтра</p>
                  <img src={(city as CityWeather).forecast_tomorrow.icon} alt="" />
                  <p>
                    {(city as CityWeather).forecast_tomorrow.max_temp} / {(city as CityWeather).forecast_tomorrow.min_temp}
                  </p>
                  <p>Ветер: {(city as CityWeather).forecast_tomorrow.wind_speed} м/с</p>
                </div>

                <div class="p-2 border rounded shadow-sm">
                  <p class="font-medium">Послезавтра</p>
                  <img src={(city as CityWeather).forecast_day_after.icon} alt="" />
                  <p>
                    {(city as CityWeather).forecast_day_after.max_temp} / {(city as CityWeather).forecast_day_after.min_temp}
                  </p>
                  <p>Ветер: {(city as CityWeather).forecast_day_after.wind_speed} м/с</p>
                </div>
              </div>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
) : (
  <p class="text-gray-500">Нет данных о погоде</p>
)}

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const tabButtons = document.querySelectorAll("[data-tab-target]");
    tabButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetId = btn.getAttribute("data-tab-target");
        const parent = btn.closest("#weather-tabs").parentNode;

        parent.querySelectorAll("[role=tabpanel]").forEach((p) => p.classList.add("hidden"));
        parent.querySelectorAll("[role=tab]").forEach((b) =>
          b.classList.remove("border-blue-600", "text-blue-600")
        );

        document.querySelector(targetId).classList.remove("hidden");
        btn.classList.add("border-blue-600", "text-blue-600");
      });
    });
  });
</script>
