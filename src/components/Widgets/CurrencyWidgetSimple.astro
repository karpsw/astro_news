---
// components/CurrencyWidgetSimple.astro
const API_URL = import.meta.env.PROD
  ? 'https://telegraf.news/api/v1/sidebar.php'
  : '/api/currencies';
---

<div id="currency-widget" class="bg-white border border-gray-200 p-4 rounded-md mb-5">
  <h2 class="text-lg font-semibold text-gray-700 mb-4">Курсы валют</h2>
  <div id="currency-content">
    <div class="animate-pulse">
      <div class="h-4 bg-gray-200 rounded mb-2"></div>
      <div class="h-4 bg-gray-200 rounded mb-2"></div>
      <div class="h-4 bg-gray-200 rounded"></div>
    </div>
  </div>
</div>

<script>
  (async function () {
    const container = document.getElementById('currency-content');

    try {
      const response = await fetch('https://telegraf.news/api/v1/sidebar.php');
      if (!response.ok) throw new Error('Network error');

      const data = await response.json();

      const formatRate = (rate, scale) => (rate / scale).toFixed(4);

      const getCurrencySymbol = (code) => {
        const symbols = { USD: '$', EUR: '€', CNY: '¥', UAH: '₴', RUB: '₽' };
        return symbols[code] || code;
      };

      const currenciesHtml = data.currencies
        .map(
          (currency) => `
        <div class="flex justify-between items-center text-sm mb-2">
          <div class="flex items-center">
            <span class="font-medium text-gray-600 mr-2">${getCurrencySymbol(currency.code)}</span>
            <span class="text-gray-600">${currency.code}</span>
          </div>
          <span class="font-semibold text-gray-800">${formatRate(currency.rate, currency.scale)} BYN</span>
        </div>
      `
        )
        .join('');

      const date = new Date(data.date).toLocaleDateString('ru-RU');

      container.innerHTML = `
        <div class="flex justify-between items-center mb-3">
          <h3 class="text-md font-semibold text-gray-700">Курсы валют</h3>
          <span class="text-xs text-gray-500">${date}</span>
        </div>
        ${currenciesHtml}
        <div class="mt-3 pt-3 border-t border-gray-100">
          <p class="text-xs text-gray-500 text-center">Курсы НБРБ</p>
        </div>
      `;
    } catch (error) {
      console.error('Error loading currencies:', error);
      container.innerHTML = `
        <p class="text-red-600 text-sm mb-2">Не удалось загрузить курсы валют</p>
        <button onclick="location.reload()" class="px-3 py-1 bg-tel-red text-white text-xs rounded hover:bg-red-700 transition-colors">
          Обновить
        </button>
      `;
    }
  })();
</script>
