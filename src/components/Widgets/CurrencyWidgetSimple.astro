---
import type { SideBarCurrDto } from '@/modules/wp-api-types';

const getCurrencySymbol = (code: string): string => {
  const symbols: Record<string, string> = {
    USD: '$',
    EUR: '€',
    CNY: '¥',
    UAH: '₴',
    RUB: '₽',
  };

  return symbols[code] ?? code;
};

export const formatRate = (rate: number, scale: number): string => {
  if (!scale || isNaN(rate) || isNaN(scale)) return '—';
  return (rate / scale).toFixed(4);
};

const { curr }: { curr?: SideBarCurrDto } = Astro.props;
---

<div class="bg-white border border-gray-200 p-4 rounded-md mb-5">
  {
    curr && (
      <>
        <div class="flex justify-between items-center mb-3">
          <h3 class="text-md font-semibold text-gray-700">Курсы валют (НБРБ)</h3>
          <span class="text-xs text-gray-500">
            {new Date(curr.date).toLocaleDateString('ru-RU')}
          </span>
        </div>

        {curr.currencies.map((currency) => (
          <div class="flex justify-between items-center text-sm mb-2">
            <div class="flex items-center">
              <span class="font-medium text-gray-600 mr-2">{getCurrencySymbol(currency.code)}</span>
              <span class="text-gray-600">{currency.code}</span>
            </div>
            <span class="font-semibold text-gray-800">
              {formatRate(currency.rate, currency.scale)} BYN
            </span>
          </div>
        ))}
      </>
    )
  }
</div>
