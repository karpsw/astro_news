---
import type { SideBarCurrDaysDto } from '@/modules/wp-api-types';

const getCurrencySymbol = (code: string): string => {
  const symbols: Record<string, string> = {
    USD: '$',
    EUR: '€',
    CNY: '¥',
    UAH: '₴',
    RUB: '₽',
    PLN: 'zł', // Добавлен символ злотого
  };

  return symbols[code] ?? code;
};

const getCurrencyName = (code: string): string => {
  const names: Record<string, string> = {
    USD: 'доллар',
    EUR: 'евро',
    CNY: 'юань',
    UAH: 'гривна',
    RUB: 'рубль',
    PLN: 'злотый',
    GBP: 'фунт',
    JPY: 'иена',
    CHF: 'франк',
    CAD: 'канадский доллар',
    AUD: 'австралийский доллар',
  };

  return names[code] ?? code;
};

export const formatRate = (rate: number, scale: number): string => {
  if (!scale || isNaN(rate) || isNaN(scale)) return '—';
  return (rate / scale).toFixed(4);
};

const { curr }: { curr?: SideBarCurrDaysDto } = Astro.props;
---

<div class="bg-white border border-gray-200 p-4 rounded-md mb-5">
  {
    curr && curr.today && (
      <>
        <div class="flex justify-between items-center mb-3">
          <h3 class="text-md font-semibold text-gray-700">Курсы валют (НБРБ)</h3>
          <span class="text-xs p-1 text-white bg-tel-red">
            {new Date(curr.today.date).toLocaleDateString('ru-RU')}
          </span>
          <span class="text-xs text-gray-500">
            {new Date(curr.previous.date).toLocaleDateString('ru-RU')}
          </span>
        </div>

        {curr.today.currencies.map((todayCurrency) => (
          <div class="flex justify-between items-center text-sm mb-2">
            <div class="flex items-center">
              <span class="font-medium text-gray-600 mr-2">{getCurrencySymbol(currency.code)}</span>
              <span class="text-gray-600">{currency.code}</span>
            </div>
            <span class="font-semibold text-gray-800">
              {formatRate(
                curr.previous.currencies.find((x) => x.code == todayCurrency.code)!.rate,
                curr.previous.currencies.find((x) => x.code == todayCurrency.code)!.scale
              )}{' '}
              BYN
            </span>
            <span class="font-semibold text-gray-800">
              {formatRate(todayCurrency.rate, todayCurrency.scale)} BYN
            </span>
          </div>
        ))}
      </>
    )
  }
</div>
