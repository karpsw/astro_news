---
// LinkToIframe.astro
const { href, children } = Astro.props;
const isTikTokEmbed = href?.startsWith('https://www.tiktok.com/player/');
---

{
  isTikTokEmbed ? (
    <iframe src={href} width="100%" height="500" frameborder="0" allowfullscreen />
  ) : (
    <a href={href} target="_blank" rel="noopener noreferrer">
      {children}
    </a>
  )
}
