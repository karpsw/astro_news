---
// Между блоками новости ~ пока не внедрил в лейзи
interface Props {
  show?: 'yes' | 'no';
}

const { show = 'yes' } = Astro.props;
---

{show === 'yes' && (
  <>

<aside id="ArticleAfterText1"></aside>

<script>

  const isMobile = window.innerWidth < 768;
  let adfoxLoaded = false; // флаг успешной загрузки AdFox
  const containerId = 'ArticleAfterText1';
  const container = document.getElementById(containerId);

  function MobilePikachu() {
    setTimeout(() => {
      if (!adfoxLoaded) {
        googletag.cmd.push(() => googletag.display(containerId));
      }
    }, 1000);
  }

   function DesktopPikachu() {
    setTimeout(() => {
      if (!adfoxLoaded) {
        googletag.cmd.push(() => googletag.display(containerId));
      }
    }, 1000);
  }

  if (container) {
    if (isMobile) {
      MobilePikachu();
    } else {
      DesktopPikachu();
    }
  }
</script>

  </>
)}