---
//  внутри текста новости #5
interface Props {
  show?: 'yes' | 'no';
}

const { show = 'yes' } = Astro.props;
---

{show === 'yes' && (
  <>
    <script>
      const MobHtml = '<aside id="ArticleIntext5"></aside>';
      const AfterP = 22;
      const MinP = 4;
      const isMobile = window.innerWidth < 768;
      const containerId = 'ArticleIntext5';

      if (isMobile) {
        const container = document.getElementById('post-text');
        if (container) {
          // проверяем, что существует параграф AfterP+4
          const checkParagraph = container.querySelector(`#p-${AfterP + MinP}`);

          if (checkParagraph) {
            insertAfterParagraph('p-' + AfterP, MobHtml);
            MobilePikachu();
          }
        }
      }

      function insertAfterParagraph(paragraphId, htmlString) {
        const container = document.getElementById('post-text');
        if (!container) return;

        const target = container.querySelector(`#${paragraphId}`);
        if (!target) return;

        target.insertAdjacentHTML('afterend', htmlString.trim());
      }

      function MobilePikachu() {
         setTimeout(() => {
            if (!adfoxLoaded) {
              googletag.cmd.push(() => googletag.display(containerId));
            }
          }, 1000);
      }
    </script>
  </>
)}
