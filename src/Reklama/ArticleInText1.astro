---
// внутри текста новости #1 ?после лида
interface Props {
  show?: 'yes' | 'no';
}

const { show = 'yes' } = Astro.props;
---

{show === 'yes' && (
  <>

<aside id="ArticleInText1"></aside>

<script>
  const isMobile = window.innerWidth < 768;
  let adfoxLoaded = false; // флаг успешной загрузки AdFox
  const containerId = 'ArticleInText1';
  const container = document.getElementById(containerId);

  function MobilePikachu() {
    window.yaContextCb.push(() => {
      Ya.adfoxCode.createAdaptive(
        {
          ownerId: 239538,
          containerId: containerId,
          params: {
            p1: 'cqamu',
            p2: 'fork',
          },
          onLoad: function (data) {
            adfoxLoaded = true;
          },
        },
        ['tablet', 'phone'],
        {
          tabletWidth: 1024,
          phoneWidth: 768,
          isAutoReloads: false,
        }
      );
    });

    setTimeout(() => {
      if (!adfoxLoaded) {
        googletag.cmd.push(() => googletag.display(containerId));
      }
    }, 1000);
  }

  function DesktopPikachu() {
    window.yaContextCb.push(() => {
      Ya.adfoxCode.createAdaptive(
        {
          ownerId: 239538,
          containerId: containerId,
          params: {
            p1: 'cnhpl',
            p2: 'y',
            puid5: 0,
          },
          onLoad: function (data) {},
        },
        ['desktop'],
        {
          tabletWidth: 1024,
          phoneWidth: 768,
          isAutoReloads: false,
        }
      );
    });
  }

  if (container) {
    if (isMobile) {
      MobilePikachu();
    } else {
      DesktopPikachu();
    }
  }
</script>

  </>
)}