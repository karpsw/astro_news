---
// внутри текста новости #2 после 6 абзаца
interface Props {
  show?: 'yes' | 'no';
}

const { show = 'yes' } = Astro.props;
---

{show === 'yes' && (
  <>


<script src="https://nzkjjqrcte.com/script.js"></script>
<script>
  const MobHtml = '<div id="citomffsfe7"></div> ';
  const isMobile = window.innerWidth < 768;
  const containerId = 'citomffsfe7';
  const container = document.getElementById(containerId);

  if (container) {
    if (isMobile) {
      insertAfterParagraph ('p-6' ,MobHtml);
      MobilePikachu();
    }
  }

  function MobilePikachu() {
    window.addEventListener("load", function () {
      !(function (w, m) {
        (w[m] || (w[m] = [])) &&
          w[m].push({ id: containerId, block: "141287", site_id: "14667" });
      })(window, "mtzBlocks");
    });
  }

  function insertAfterParagraph(paragraphId, htmlString) {
  const container = document.getElementById('post-text');
  if (!container) return;

  const target = container.querySelector(`#${paragraphId}`);
  if (!target) return;

  target.insertAdjacentHTML('afterend', htmlString.trim());
}
</script>

  </>
)}