---
import { getHome } from '@/modules/wp-api';
import NewsBase from '@/layouts/NewsBase.astro';
import NewsPostCard, { NewsPostCardLayout } from '@/components/NewsPostCard.astro';

const data = await getHome();
---

<NewsBase {...data.metaHead}>
  <main class="container grid grid-cols-1 gap-8 flex-grow">
    <section class="mt-10">
      <h2 class="text-2xl font-bold mb-4">Подобрали для вас</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {
          data.newsBlockOne &&
            data.newsBlockOne.map((post) => (
              <NewsPostCard post={post} layout={NewsPostCardLayout.variant4} />
            ))
        }
      </div>
    </section>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      <!-- Карточка новости -->
      {
        data.newsBlockOne &&
          data.newsBlockOne.map((post) => (
            <NewsPostCard post={post} layout={NewsPostCardLayout.variant5} />
          ))
      }
    </div>
  </main>
</NewsBase>
