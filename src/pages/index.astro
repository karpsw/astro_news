---
import { getHome } from '@/modules/post/getHome';
import NewsBase from '@/layouts/NewsBase.astro';
import NewsPostCard from '@/components/NewsPostCard.astro';

const data = await getHome();
---

<NewsBase {...data.metaHead}>
  <main class="container grid grid-cols-1 gap-8">
    <section class="mt-10">
      <h2 class="text-2xl font-bold mb-4">Подобрали для вас</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {data.newsBlockOne && data.newsBlockOne.map((post) => <NewsPostCard {post} />)}
      </div>
    </section>
  </main>
</NewsBase>
