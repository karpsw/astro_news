---
import { getWpSideBar } from '@/modules/wp-api';
import NewsPostCard, { NewsPostCardLayout } from '@/components/NewsPostCard.astro';
import CurrencyWidgetSimple from '@/components/Widgets/CurrencyWidgetSimple.astro';

import type { SideBarDto } from '@/modules/wp-api-types';

layout: false;

const data: SideBarDto = await getWpSideBar();
---

<!--  Currency Block -->
<CurrencyWidgetSimple curr={data.curr} />
<!--   Weather Block -->

<div class="bg-white border border-gray-200 p-4 rounded-md my-5">
  <h2 class="text-lg font-semibold text-gray-700 mb-2">Погода</h2>
  <p class="text-sm text-gray-600">Бобруйск: +24°C, ясно</p>
  <p class="text-sm text-gray-600">Влажность: 45%, Ветер: 3 м/с</p>
</div>

<!--  Последние новости -->
<div class="w-full flex items-center justify-between my-5 p-2 bg-sky-50">
  <span class="font-bold">Последние новости</span>
</div>
<div class="grid grid-cols-1 gap-4">
  {
    data.news_lenta &&
      data.news_lenta.map((post) => (
        <NewsPostCard post={post} layout={NewsPostCardLayout.variant5} />
      ))
  }
</div>
